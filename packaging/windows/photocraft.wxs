<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="TSPhoto" Manufacturer="Solusi Daya Indonesia" Version="$(var.Version)" UpgradeCode="8D40B821-0D46-4EC0-907B-BE668E8B63B0" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="TSPhoto" Manufacturer="Solusi Daya Indonesia" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of TSPhoto is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotocraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotocraftIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Solusi Daya Indonesia">
        <Directory Id="INSTALLFOLDER" Name="TSPhoto" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by PhotocraftApp). -->

    <Feature Id="Main" Title="TSPhoto" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="PhotocraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotocraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photocraft.en-us.wxl. -->
    <Property Id="PhotocraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="TSPhoto $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch TSPhoto" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotocraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotocraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="PhotocraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PhotocraftApp" Guid="60069FB4-F4C8-4441-8B63-1716526D02F2">
        <File Id="PhotocraftExe" Source="$(var.BinDir)\tsphoto.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="TSPhoto" Description="TSPhoto" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="PhotocraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: PhotoCraft's own format; PhotoCraft is its default app. -->
        <ProgId Id="TSPhoto.Document" Description="TSPhoto Document" Icon="PhotocraftExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-photocraft">
            <Verb Id="open" Command="Open" TargetFile="PhotocraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="TSPhoto.PhotoshopDocument" Description="PSD Document" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\TSPhoto.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="TSPhoto.Image" Description="Image" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\TSPhoto.Image\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="TSPhoto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="TSPhoto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="TSPhoto.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "photocraft"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe" Name="FriendlyAppName" Value="TSPhoto" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\tsphoto.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\tsphoto.exe" Value="[#PhotocraftExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Solusi Daya Indonesia\TSPhoto" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotocraftCli" Guid="7B69244E-F54D-4D0A-9357-6C00E0278A4B">
        <File Id="PhotocraftCliExe" Source="$(var.BinDir)\tsphoto-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
